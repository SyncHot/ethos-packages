{
  "schema": 2,
  "id": "vmm",
  "name": "EthOS VM Manager",
  "version": "1.0.0",
  "description": "Run Windows and Linux virtual machines on this NAS with hardware acceleration. Create a VM from an ISO, boot it, and use it from the browser console - no separate computer left running. Disks live on your own shares, VMs start again after a restart, and every VM is isolated in its own process.",
  "icon": "🖥️",
  "icon_url": "https://raw.githubusercontent.com/SyncHot/ethos-packages/main/vmm/icon.svg",
  "category": "tools",
  "author": "SyncHot",
  "homepage": "https://github.com/SyncHot/ethos-packages",
  "license": "MIT",
  "channel": "stable",
  "capabilities": [
    "compose",
    "kvm"
  ],
  "ui": {
    "mode": "native",
    "entry": "frontend/app.js",
    "port": 8095
  },
  "healthcheck": {
    "scheme": "http",
    "port": 8095,
    "path": "/api/health"
  },
  "changelog": "1.0.0: first release. KVM virtual machines with a browser console: create a VM from an ISO stored on the NAS, start, stop and reset it, follow its live status, and let it start automatically with EthOS. Disks are qcow2 files on a share you pick. Snapshots, cloning and OVA export follow in 1.1.",
