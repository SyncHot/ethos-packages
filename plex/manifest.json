{
  "schema": 2,
  "id": "plex",
  "name": "Plex Media Server",
  "version": "1.0.2",
  "description": "Plex for the NAS: films, series, music and photos with rich metadata, apps on every TV and phone, and hardware transcoding on the host GPU (Intel/AMD Quick Sync via /dev/dri, NVIDIA when the Docker nvidia runtime is configured). The library is mounted read-only from the shares and the database lives in a package folder that survives updates.",
  "icon": "▶️",
  "icon_url": "https://raw.githubusercontent.com/SyncHot/ethos-packages/main/plex/icon.svg",
  "category": "media",
  "author": "SyncHot",
  "homepage": "https://www.plex.tv",
  "license": "Proprietary (Plex EULA)",
  "channel": "stable",
  "min_ethos_version": "2.42.0",
  "capabilities": [
    "compose",
    "dri",
    "nvidia"
  ],
  "ui": {
    "mode": "window",
    "scheme": "http",
    "port": 32400,
    "path": "/web",
    "expose": "lan",
    "auth": "package",
    "embed": false
  },
  "healthcheck": {
    "scheme": "http",
    "port": 32400,
    "path": "/identity"
  },
  "data": {
    "mount": "/config",
    "label": "Plex database folder"
  },
  "settings": [
    {
      "key": "tz",
      "env": "TZ",
      "label": "Timezone",
      "default": "Europe/Warsaw",
      "required": true,
      "max_length": 64
    },
    {
      "key": "plex_claim",
      "env": "PLEX_CLAIM",
      "label": "Claim token (plex.tv/claim, optional)",
      "type": "text",
      "default": "",
      "required": false,
      "max_length": 64
    },
    {
      "key": "advertise_ip",
      "env": "ADVERTISE_IP",
      "label": "Advertised URL (optional, e.g. http://192.168.1.20:32400)",
      "type": "text",
      "default": "",
      "required": false,
      "max_length": 120
    },
    {
      "key": "allowed_networks",
      "env": "ALLOWED_NETWORKS",
      "label": "Networks trusted without Plex login (needed to finish setup)",
      "type": "text",
      "default": "172.16.0.0/12,10.0.0.0/8,192.168.0.0/16",
      "required": false,
      "max_length": 200
    }
  ],
  "system_requires": [
    "docker"
  ],
  "changelog": "1.0.2: ALLOWED_NETWORKS setting (LAN + Docker ranges) so the claim/setup wizard can be reached without host networking, transcode scratch on its own volume, and a claim-token walkthrough. 1.0.1: the icon ships in files[]. 1.0.0: first release — Plex Media Server 1.43.5, data folder that survives updates, read-only media, VAAPI/QuickSync via /dev/dri and NVENC, CPU fallback without a GPU.",
  "compose": {
    "url": "https://raw.githubusercontent.com/SyncHot/ethos-packages/main/plex/docker-compose.yml",
    "sha256": "691dee6f8895f1089b2ed27cd10b702d2b6241fe8d395dccef80824c4384c2bd"
  },
  "files": [
    {
      "url": "https://raw.githubusercontent.com/SyncHot/ethos-packages/main/plex/icon.svg",
      "sha256": "ebcf05846f371b4259a8c3c2f43c7cdb2dd5c8c8593a408af9d8ed93979366cd",
      "path": "icon.svg",
      "mode": 420
    }
  ]
}
