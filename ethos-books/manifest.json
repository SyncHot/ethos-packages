{
  "schema": 2,
  "id": "ethos-books",
  "name": "Books",
  "version": "1.0.0",
  "description": "Read EPUB and PDF books and listen to audiobooks that already live on your NAS. Folders are browsed through the EthOS file API, so nothing is copied and your permissions still apply; covers and your place in every title are kept per account.",
  "icon": "📚",
  "icon_url": "https://raw.githubusercontent.com/SyncHot/ethos-packages/main/ethos-books/icon.svg",
  "category": "media",
  "author": "SyncHot",
  "homepage": "https://github.com/SyncHot/ethos-packages",
  "license": "MIT",
  "channel": "stable",
  "min_ethos_version": "2.0.0",
  "runtime": "venv",
  "user_access": true,
  "ui": {
    "mode": "native",
    "entry": "frontend/app.js",
    "port": 8089
  },
  "healthcheck": {
    "scheme": "http",
    "port": 8089,
    "path": "/health"
  },
  "changelog": "1.0.0: first release — a library for EPUB, PDF and audiobooks with per-account progress. Add one or more folders, scan them through the EthOS file API (no copying, no extra share access), and read in a paginated or scrolled reader with light, sepia and dark themes. Audiobooks play from .m4b files or folders of .mp3/.flac tracks with resume, speed, skip and a sleep timer. Covers, titles, authors and series are extracted in the browser; the package service stores metadata only.",
