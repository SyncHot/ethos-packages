{
  "schema": 2,
  "id": "ethos-welcome",
  "name": "EthOS Welcome",
  "version": "1.0.4",
  "description": "A tiny static welcome page for your NAS, served by nginx on port 8090.",
  "icon": "🌅",
  "icon_url": "https://raw.githubusercontent.com/SyncHot/ethos-packages/main/ethos-welcome/icon.svg",
  "category": "demo",
  "author": "SyncHot",
  "homepage": "https://github.com/SyncHot/ethos-packages",
  "license": "MIT",
  "channel": "stable",
  "min_ethos_version": "2.0.0",
  "ui": {
    "mode": "window",
    "scheme": "http",
    "port": 8090,
    "path": "/",
    "expose": "lan",
    "auth": "none"
  },
  "changelog": "1.0.4: nginx is pinned to a real version and the container has a healthcheck; the manifest states that port 8090 is reachable on your network and has no login. 1.0.3: Package Center now offers Open UI for the page on port 8090; requires EthOS 2.0. 1.0.2: light and dark themes, honours the ?theme= passed by EthOS and falls back to prefers-color-scheme. 1.0.1: Package Center icon. 1.0.0: initial release: static welcome page with a live clock.",
  "system_requires": [
    "docker"
  ],
